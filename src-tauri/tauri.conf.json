{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentEye",
  "version": "0.1.0",
  "identifier": "com.agenteye.app",
  "build": {
    "beforeDevCommand": "npm --prefix ui run start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "../ui/dist/ui/browser"
  },
  "app": {
    "windows": [
      {
        "title": "AgentEye",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:4200 http://localhost:4200; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
